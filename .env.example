# ─────────────────────────────────────────────────────────────
# Smart Water Management & Pump Health Monitoring System
# Environment Variables Template
#
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────

# SQLite (default, zero-config):
DATABASE_URL=sqlite:///./data/water_management.db

# PostgreSQL (production example):
# DATABASE_URL=postgresql://user:password@localhost:5432/water_mgmt

# Secret key used by the ESP32 firmware to authenticate telemetry and command requests.
# Must match DEVICE_API_KEY constant in esp32_water_controller.ino.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
DEVICE_API_KEY=change-me-device-key-123

# Bearer token used by the frontend to call protected REST endpoints.
# Must match VITE_FRONTEND_TOKEN below.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
FRONTEND_API_TOKEN=change-me-frontend-token-456

# Set to true to generate synthetic sensor data without physical hardware.
# Set to false when running with a real ESP32 device.
SIMULATION_MODE=true

# Comma-separated list of allowed CORS origins.
# Add your production frontend URL when deploying publicly.
CORS_ORIGINS=http://localhost:5173

# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Frontend (Vite – variables must be prefixed with VITE_) ──

# Base URL of the backend REST API, as seen by the browser.
VITE_API_URL=http://localhost:8000

# Bearer token for frontend API authentication (must match FRONTEND_API_TOKEN above).
VITE_FRONTEND_TOKEN=change-me-frontend-token-456

# WebSocket base URL for the real-time dashboard connection.
VITE_WS_URL=ws://localhost:8000
